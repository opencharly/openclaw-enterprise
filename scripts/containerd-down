#!/usr/bin/env bash
# Stop the stack scripts/containerd-up started.
#
# By default this stops the controller, the worker and the PostgreSQL workload and keeps the
# engine volume and the state directory, so the next `scripts/containerd-up` resumes the same
# platform state. `--purge` also removes the engine volume that holds the database and the
# state directory, which discards that state.
set -euo pipefail
umask 077

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

namespace="${OCC_CONTAINERD_NAMESPACE:-openclaw-enterprise}"
state_dir="${OCC_CONTAINERD_STATE:-$HOME/.local/state/oce-containerd}"
purge=0

usage() {
  cat >&2 <<'EOF'
Usage: scripts/containerd-down [options]

  --namespace NAME   containerd namespace the stack runs in (default openclaw-enterprise)
  --state DIRECTORY  state directory (default ~/.local/state/oce-containerd)
  --purge            also remove the PostgreSQL engine volume and the state directory
  --help             print this message
EOF
}

fail() {
  printf 'containerd-down: %s: %s\n' "$1" "$2" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --namespace) namespace="${2:-}"; shift 2 ;;
    --state) state_dir="${2:-}"; shift 2 ;;
    --purge) purge=1; shift ;;
    --help) usage; exit 0 ;;
    *) usage; fail "arguments" "unknown option $1" ;;
  esac
done

command -v nerdctl >/dev/null 2>&1 || fail "preconditions" "nerdctl is not on PATH"

postgres_container="oce-containerd-postgres"
postgres_volume="oce-containerd-postgres-data"

for role in controller worker; do
  pid_file="$state_dir/$role.pid"
  if [ -f "$pid_file" ]; then
    pid="$(cat "$pid_file")"
    if kill -0 "$pid" 2>/dev/null; then
      printf 'containerd-down: stopping the %s (pid %s)\n' "$role" "$pid"
      kill -TERM "$pid" 2>/dev/null || true
      for _ in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    fi
    rm -f "$pid_file"
  fi
done

if nerdctl -n "$namespace" ps --format '{{.Names}}' | grep -qx "$postgres_container"; then
  printf 'containerd-down: removing %s\n' "$postgres_container"
  nerdctl -n "$namespace" rm -f "$postgres_container" >/dev/null ||
    fail "database" "could not remove $postgres_container"
  # A container that is still shutting down keeps the database volume open, and removing the
  # volume then leaves the old cluster in place where the next bring-up would silently reuse it.
  for _ in $(seq 1 100); do
    nerdctl -n "$namespace" ps -a --format '{{.Names}}' | grep -qx "$postgres_container" || break
    sleep 0.3
  done
  if nerdctl -n "$namespace" ps -a --format '{{.Names}}' | grep -qx "$postgres_container"; then
    fail "database" "$postgres_container is still present after removal"
  fi
fi
rm -f "$state_dir/postgres.container-id" "$state_dir/postgres.env"

if [ "$purge" -eq 1 ]; then
  if nerdctl -n "$namespace" volume ls --format '{{.Name}}' | grep -qx "$postgres_volume"; then
    printf 'containerd-down: removing the engine volume %s\n' "$postgres_volume"
    nerdctl -n "$namespace" volume rm "$postgres_volume" >/dev/null ||
      fail "database" "could not remove the volume $postgres_volume"
    if nerdctl -n "$namespace" volume ls --format '{{.Name}}' | grep -qx "$postgres_volume"; then
      fail "database" "the volume $postgres_volume survived; a bring-up would reuse the old cluster"
    fi
  fi
  if [ -d "$state_dir" ]; then
    printf 'containerd-down: removing the state directory %s\n' "$state_dir"
    rm -rf "$state_dir"
  fi
  if [ -f "$state_dir/namespaces" ]; then
    while read -r id; do
      [ -n "$id" ] || continue
      managed="$(nerdctl -n "$namespace" ps -a --filter "label=org.openclaw.enterprise.namespace-id=$id" --format '{{.Names}}' 2>/dev/null || true)"
      if [ -n "$managed" ]; then
        printf 'containerd-down: removing the platform containers of Namespace %s\n' "$id"
        printf '%s\n' "$managed" | xargs -r nerdctl -n "$namespace" rm -f >/dev/null 2>&1 || true
      fi
      # The Driver's per-Agent volumes carry the same Namespace label; they are part of what this
      # stack created and would otherwise accumulate on the engine.
      volumes="$(nerdctl -n "$namespace" volume ls --filter "label=org.openclaw.enterprise.namespace-id=$id" --format '{{.Name}}' 2>/dev/null || true)"
      if [ -n "$volumes" ]; then
        printf '%s\n' "$volumes" | xargs -r nerdctl -n "$namespace" volume rm >/dev/null 2>&1 || true
      fi
    done <"$state_dir/namespaces"
  fi
  printf 'containerd-down: the stack and its database are gone\n'
else
  printf 'containerd-down: the stack is stopped; the database volume %s and %s are kept\n' \
    "$postgres_volume" "$state_dir"
  printf 'containerd-down: Agent containers stay on the engine; --purge removes them too\n'
fi
